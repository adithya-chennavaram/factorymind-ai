# Export settings before launch; this file is not automatically loaded.
LLM_PROVIDER=amd_tokenfactory
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_MODEL=DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=300
LLM_TOP_P=1
# Supply LLM_API_KEY privately in the environment. Never commit it.
# Without a valid key, investigation uses an explicitly labeled rule-based fallback.
