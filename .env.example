# Explicit local profile (default). Export variables before launching; not auto-loaded.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60
LLM_DISABLE_THINKING=0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=300
LLM_TOP_P=1

# Remote AMD profile: uncomment only AFTER approved host setup and connection checks.
# LLM_PROVIDER=amd_vllm
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=factorymind-<32-character-deployment-id-from-hardware-record>
# LLM_MODEL_ID=<actual-selected-model-repository>
# LLM_MODEL_REVISION=<reviewed-40-character-model-commit>
# LLM_HARDWARE_EVIDENCE=/absolute/path/to/amd_hardware.json
# LLM_API_KEY must be a private random token of at least 16 characters.
# Set it interactively/in your secret manager, never in tracked files or URLs.
# Only loopback/tunnel HTTP or remote HTTPS is accepted. TLS verification stays on.

# AMD ACT III Token Factory — managed AMD-hosted model API, no GPU instance needed.
# This is distinct from the superseded self-hosted AMD vLLM profile above.
# LLM_PROVIDER=amd_tokenfactory
# LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# LLM_MODEL=DeepSeek-V4-Flash
# LLM_TIMEOUT_SECONDS=60
# LLM_DISABLE_THINKING=0
# LLM_MAX_TOKENS=300
# LLM_API_KEY: NEVER add here; enter privately using an environment variable.
